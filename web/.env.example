# AWS 리전 (서울)
AWS_REGION=ap-northeast-2

# Cognito — User Pool + App Client (USER_PASSWORD_AUTH 활성화, 시크릿 없는 앱 클라이언트)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Aurora Serverless v2 (PostgreSQL) — RDS Data API 활성화 필요
AURORA_RESOURCE_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE=sentence_today

# S3 (프로필 이미지 업로드)
S3_BUCKET=
# 공개 URL 베이스 (CloudFront 도메인 등). 비우면 S3 기본 URL 사용
S3_PUBLIC_BASE_URL=

# Anthropic Claude (Week 4 — 언어 패턴 리포트 / 감성 태그)
ANTHROPIC_API_KEY=

# 로컬 개발 시 AWS 자격증명은 기본 자격증명 체인(`aws configure`)을 사용한다.
# Amplify Hosting 배포 시에는 서비스 역할(IAM)로 자동 주입된다.
